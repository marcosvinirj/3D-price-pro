// Schema do banco (PostgreSQL em producao via DATABASE_URL).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  senhaHash  String
  role       String      @default("operador") // admin | operador (nao usado mais p/ controle de dados)
  criadoEm   DateTime    @default(now())
  orcamentos Orcamento[]

  // Multi-tenant: cada usuario e dono do seu proprio espaco de dados,
  // isolado dos demais. Sem papel privilegiado sobre dados de outro usuario.
  materiais       Material[]
  impressoras     Impressora[]
  custosFixos     CustoFixo[]
  custosVariaveis CustoVariavel[]
  moedas          Moeda[]
  configuracao    Configuracao?
}

model Material {
  id              Int         @id @default(autoincrement())
  nome            String
  tipo            String // PLA, PETG, ABS, resina...
  precoKg         Float
  densidade       Float?
  cor             String?
  estoqueG        Float       @default(0)
  estoqueMinimoG  Float       @default(0)
  taxaDesperdicio Float       @default(0.05) // fracao (0.05 = 5%)
  ativo           Boolean     @default(true)
  criadoEm        DateTime    @default(now())
  itens           OrcamentoItem[]

  usuarioId Int
  usuario   User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Impressora {
  id                   Int         @id @default(autoincrement())
  nome                 String
  marca                String?
  modelo               String?
  dataCompra           String? // ISO "AAAA-MM-DD" (data de compra)
  potenciaW            Float
  valorAquisicao       Float
  vidaUtilH            Float
  custoManutencaoAnual Float       @default(0) // custo anual de manutencao
  taxaManutencao       Float       @default(0)
  taxaFalhaPadrao      Float       @default(0.1) // taxa media de falha (fracao); prefill no orcamento
  ativo                Boolean     @default(true)
  criadoEm             DateTime    @default(now())
  orcamentos           Orcamento[]

  usuarioId Int
  usuario   User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model CustoFixo {
  id          Int      @id @default(autoincrement())
  nome        String
  valorMensal Float
  criadoEm    DateTime @default(now())

  usuarioId Int
  usuario   User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// Custos variaveis por peca (cola, alcool, embalagem, etiqueta, frete...).
// Sao SELECIONADOS por orcamento; a soma dos escolhidos entra no custo total.
model CustoVariavel {
  id            Int      @id @default(autoincrement())
  nome          String
  valorUnitario Float // custo por peca quando aplicado
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())

  usuarioId Int
  usuario   User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// Moedas para EXIBICAO, por usuario. O calculo e sempre na moeda base EUR
// (fonte da verdade); a moeda so converte valores mostrados. taxaParaBase =
// quanto vale 1 unidade em EUR.
model Moeda {
  id     Int    @id @default(autoincrement())
  codigo String // "EUR", "USD", "GBP" — unico POR usuario, nao globalmente
  nome   String
  simbolo      String
  // @map preserva a coluna historica "taxaParaBRL" no banco (sem migracao de dados).
  taxaParaBase Float    @map("taxaParaBRL") // 1 unidade = X EUR; EUR = 1
  base         Boolean  @default(false) // EUR e a base, sempre taxa 1
  criadoEm     DateTime @default(now())

  usuarioId Int
  usuario   User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, codigo])
}

// Parametros globais de precificacao — uma linha por usuario.
model Configuracao {
  precoKwh           Float @default(0.95)
  valorHoraTrabalho  Float @default(20)
  // Horas produtivas da impressora no mes: divisor do rateio de custo fixo
  // (custo fixo/hora = custosFixosMensais / horasProdutivasMes).
  horasProdutivasMes Float @default(160)
  margemMinima       Float @default(0.2)

  usuarioId Int  @id
  usuario   User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Orcamento {
  id            Int      @id @default(autoincrement())
  cliente       String?
  telefone      String? // WhatsApp do cliente (com DDI), para envio do orcamento
  descricaoPeca String?
  status        String   @default("pendente") // pendente | aprovado | recusado

  // Snapshots imutaveis (regras 5 e 6): guardam entrada e resultado no momento
  // da emissao. Reajuste (ou edicao, enquanto pendente) gera um novo snapshot;
  // orcamentos ja aprovados nunca sao alterados.
  entradaJson   String
  resultadoJson String

  precoFinal   Float
  precoCobrado Float

  impressoraId   Int
  usuarioId      Int
  estoqueBaixado Boolean   @default(false)
  criadoEm       DateTime  @default(now())
  aprovadoEm     DateTime?

  itens      OrcamentoItem[]
  impressora Impressora      @relation(fields: [impressoraId], references: [id])
  usuario    User            @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

// Uma peca dentro de um orcamento (ex.: "Cauda", "Torso" de um modelo
// impresso em varias partes). Cada peca pode usar um material/cor proprio.
model OrcamentoItem {
  id                     Int    @id @default(autoincrement())
  nome                   String?
  pesoG                  Float
  tempoImpressaoH        Float
  tempoPosProcessamentoH Float
  // Snapshots calculados na criacao/edicao (regra 6): nao mudam se o
  // material for reajustado depois.
  consumoG               Float // pesoG * (1 + taxaDesperdicio) no momento do calculo
  custoItem              Float // custo desta peca (sem markup), para exibicao
  ordem                  Int    @default(0)

  orcamentoId Int
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  materialId  Int
  material    Material  @relation(fields: [materialId], references: [id])

  @@index([orcamentoId])
  @@index([materialId])
}
