# Banco Postgres (local: docker/postgres; producao: Neon, Render, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo do JWT — gere um valor longo e aleatorio, nao reutilize o de dev
JWT_SECRET="troque-por-um-valor-aleatorio-longo-em-producao"
JWT_EXPIRES_IN="7d"

PORT=3333

# Para onde o Stripe Checkout/Portal volta depois do pagamento.
FRONTEND_URL="http://localhost:5173"

# Stripe. Use chaves sk_test_... em desenvolvimento e sk_live_... so' ao
# cobrar de verdade. Os STRIPE_PRICE_* sao gerados (de forma idempotente)
# por `npx tsx src/scripts/stripeSetup.ts`, que imprime os valores pra colar
# aqui; o STRIPE_WEBHOOK_SECRET vem de `src/scripts/stripeWebhookSetup.ts`
# (ou do painel da Stripe, em Developers > Webhooks).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ASSINATURA=""   # assinatura Pro: 600 creditos/mes
STRIPE_PRICE_PACOTE=""       # pacote avulso: 300 creditos, pagamento unico
STRIPE_PRICE_ILIMITADO=""    # assinatura Ilimitado: liga creditosIlimitados
STRIPE_WEBHOOK_SECRET=""
