# Banco Postgres (local: docker/postgres; producao: Neon, Render, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo do JWT — gere um valor longo e aleatorio, nao reutilize o de dev
JWT_SECRET="troque-por-um-valor-aleatorio-longo-em-producao"
JWT_EXPIRES_IN="7d"

PORT=3333
